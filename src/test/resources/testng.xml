<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Fintech Enterprise Hybrid Test Suite" parallel="methods" thread-count="4" verbose="2">

    <listeners>
        <!-- Real-Time Metrics to InfluxDB/Grafana and Allure Screenshot Attachment -->
        <listener class-name="com.fintech.framework.observability.GrafanaTestListener"/>
        <!-- Automatic Retry for Flaky Network Calls -->
        <listener class-name="com.fintech.framework.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="API and Event Stream Tests">
        <classes>
            <class name="com.fintech.tests.api.CardIssuanceApiTest"/>
            <class name="com.fintech.tests.kafka.PaymentEventKafkaTest"/>
        </classes>
    </test>

    <test name="UI and E2E Hybrid Tests">
        <classes>
            <class name="com.fintech.tests.ui.CardManagementUiTest"/>
            <class name="com.fintech.tests.e2e.EndToEndFintechLifecycleTest"/>
        </classes>
    </test>

</suite>
